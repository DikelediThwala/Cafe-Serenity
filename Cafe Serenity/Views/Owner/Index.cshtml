@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<style>
    :root {
        --coffee-dark: #30221d;
        --coffee: #76513e;
        --coffee-light: #a77b5d;
        --cream: #faf7f2;
        --cream-dark: #f0e8dd;
        --muted: #8b8179;
        --green: #56745c;
    }

    #content {
        background: #faf8f5;
        min-height: 100vh;
    }

        #content > .navbar {
            background: transparent !important;
            border-bottom: 1px solid #eee6dd;
            padding: 15px 24px;
        }

    .cafe-dashboard {
        color: var(--coffee-dark);
        padding: 10px 8px 35px;
        font-family: "Segoe UI", sans-serif;
    }

        .cafe-dashboard h1,
        .cafe-dashboard h2,
        .cafe-dashboard h3,
        .cafe-dashboard h4,
        .cafe-dashboard h5,
        .cafe-dashboard p {
            margin-top: 0;
        }

    .welcome-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin: 12px 0 28px;
        flex-wrap: wrap;
    }

    .eyebrow {
        color: var(--coffee-light);
        font-size: 11px;
        letter-spacing: 2.5px;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .welcome-title {
        font-size: clamp(28px, 3vw, 39px);
        font-weight: 750;
        letter-spacing: -1.5px;
        margin-bottom: 9px;
        color: var(--coffee-dark);
    }

    .welcome-description {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .date-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        background: white;
        border: 1px solid #eee5db;
        border-radius: 14px;
        padding: 13px 17px;
        color: var(--coffee);
        font-size: 13px;
        box-shadow: 0 4px 16px rgba(48, 34, 29, .035);
    }

    .hero-banner {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border-radius: 24px;
        padding: 35px;
        min-height: 245px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        color: #fffaf5;
        background: linear-gradient(100deg, rgba(40, 27, 22, .97) 0%, rgba(67, 44, 33, .93) 52%, rgba(67, 44, 33, .48) 100%), url('https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&fit=crop&w=1500&q=85') center 53% / cover;
        box-shadow: 0 14px 35px rgba(48, 34, 29, .13);
        margin-bottom: 35px;
    }

        .hero-banner::after {
            content: "";
            position: absolute;
            z-index: -1;
            width: 250px;
            height: 250px;
            right: 12%;
            top: -150px;
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 50%;
            box-shadow: 0 0 0 28px rgba(255,255,255,.035), 0 0 0 58px rgba(255,255,255,.025);
        }

    .hero-content {
        max-width: 520px;
    }

    .hero-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #f1d2b3;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 15px;
    }

        .hero-label span {
            height: 6px;
            width: 6px;
            background: #c8a17f;
            border-radius: 50%;
        }

    .hero-banner h2 {
        color: #fffaf5;
        font-size: clamp(26px, 3vw, 37px);
        font-weight: 700;
        letter-spacing: -1px;
        line-height: 1.2;
        margin-bottom: 12px;
    }

    .hero-banner p {
        color: #dfd0c4;
        font-size: 13px;
        line-height: 1.8;
        max-width: 430px;
        margin-bottom: 23px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .btn-coffee {
        background: #f3e2d0;
        color: #3b281e;
        border: 1px solid #f3e2d0;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        padding: 12px 17px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: .2s ease;
    }

        .btn-coffee:hover {
            background: #fff4e8;
            color: #3b281e;
            transform: translateY(-2px);
        }

    .btn-hero-outline {
        border: 1px solid rgba(255,255,255,.27);
        color: white;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        padding: 12px 17px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: .2s ease;
    }

        .btn-hero-outline:hover {
            color: white;
            background: rgba(255,255,255,.09);
        }

    .hero-decoration {
        width: 110px;
        height: 110px;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-right: 15px;
        color: #e8c6a6;
    }

        .hero-decoration i {
            font-size: 53px;
        }

    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 19px;
    }

        .section-heading h3 {
            font-size: 20px;
            letter-spacing: -.5px;
            font-weight: 750;
            margin-bottom: 5px;
        }

        .section-heading p {
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 0;
        }

    .section-kicker {
        color: var(--coffee-light);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .management-card {
        display: block;
        height: 100%;
        text-decoration: none;
        color: inherit;
        background: white;
        border: 1px solid #eee8e0;
        border-radius: 19px;
        padding: 23px;
        position: relative;
        overflow: hidden;
        transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }

        .management-card:hover {
            color: inherit;
            transform: translateY(-5px);
            border-color: #d9c5b3;
            box-shadow: 0 15px 32px rgba(48,34,29,.075);
        }

    .management-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .management-icon {
        width: 48px;
        height: 48px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .icon-brown {
        background: #f2e6da;
        color: #81583f;
    }

    .icon-green {
        background: #e7eee6;
        color: #547254;
    }

    .icon-rose {
        background: #f5e7e3;
        color: #9d6657;
    }

    .icon-blue {
        background: #e7ebf2;
        color: #61718d;
    }

    .card-arrow {
        color: #b7aaa0;
        font-size: 17px;
        transition: transform .2s ease;
    }

    .management-card:hover .card-arrow {
        transform: translate(3px, -3px);
        color: var(--coffee);
    }

    .management-card h4 {
        font-size: 17px;
        font-weight: 750;
        letter-spacing: -.3px;
        margin-bottom: 9px;
    }

    .management-card p {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.8;
        margin-bottom: 20px;
        min-height: 43px;
    }

    .card-link {
        font-size: 11px;
        color: var(--coffee);
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .bottom-grid {
        margin-top: 32px;
    }

    .panel {
        background: white;
        border: 1px solid #eee8e0;
        border-radius: 19px;
        padding: 25px;
        height: 100%;
    }

    .panel-title {
        font-size: 16px;
        font-weight: 750;
        margin-bottom: 5px;
    }

    .panel-subtitle {
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 23px;
    }

    .workflow-item {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 16px 0;
        border-bottom: 1px solid #f2eee9;
    }

        .workflow-item:first-of-type {
            padding-top: 0;
        }

        .workflow-item:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

    .workflow-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 33px;
        height: 33px;
        flex-shrink: 0;
        border-radius: 11px;
        background: var(--cream);
        color: var(--coffee);
        font-size: 12px;
        font-weight: 800;
    }

    .workflow-item h5 {
        font-size: 12px;
        font-weight: 750;
        margin-bottom: 5px;
    }

    .workflow-item p {
        color: var(--muted);
        font-size: 11px;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .preview-panel {
        background: #30221d;
        color: #fff7f0;
        border-radius: 19px;
        padding: 25px;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .preview-panel::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.1);
            right: -80px;
            bottom: -85px;
            box-shadow: 0 0 0 22px rgba(255,255,255,.025);
        }

    .preview-overline {
        color: #c5a58b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    .preview-panel h4 {
        color: #fff7f0;
        font-size: 23px;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 11px;
    }

    .preview-panel > p {
        font-size: 12px;
        color: #d0c0b4;
        line-height: 1.8;
        margin-bottom: 24px;
    }

    .preview-link {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: #3c2b22;
        background: #f3e2d0;
        border-radius: 9px;
        padding: 12px 15px;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
        position: relative;
        z-index: 1;
        transition: .2s ease;
    }

        .preview-link:hover {
            color: #3c2b22;
            background: white;
        }

    .dashboard-footer {
        margin-top: 30px;
        padding-top: 18px;
        border-top: 1px solid #eee6dd;
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        color: #a0968d;
        font-size: 10px;
        letter-spacing: .3px;
    }

    @@media (max-width: 768px) {
        .cafe-dashboard {
            padding: 5px 0 25px;
        }

        .hero-banner {
            padding: 26px 23px;
            min-height: auto;
        }

        .hero-decoration {
            display: none;
        }

        .welcome-title {
            font-size: 29px;
        }

        .management-card {
            padding: 20px;
        }

        .panel {
            padding: 21px;
        }
    }


    .management-card-button {
        width: 100%;
        text-align: left;
        font-family: inherit;
        cursor: pointer;
        appearance: none;
    }
</style>

<div class="cafe-dashboard">

    <!-- Welcome heading -->
    <section class="welcome-row">
        <div>
            <div class="eyebrow">Café Serenity · Administration</div>
            <h1 class="welcome-title">A little overview of your café.</h1>
            <p class="welcome-description">
                Welcome back. Everything you need to manage your café starts here.
            </p>
        </div>

        <div class="date-chip">
            <i class="bi bi-calendar3"></i>
            <span id="dashboardDate">Your workspace</span>
        </div>
    </section>

    <!-- Hero banner -->
    <section class="hero-banner">
        <div class="hero-content">
            <div class="hero-label">
                <span></span> YOUR CAFÉ, YOUR WAY
            </div>

            <h2>Make every detail<br />feel like Café Serenity.</h2>

            <p>
                Keep your menu fresh, your products organised and your
                café information ready for your customers.
            </p>

            <div class="hero-actions">
                <a asp-controller="Product"
                   asp-action="AddCoffee"
                   class="btn-coffee">
                    <i class="bi bi-plus-lg"></i>
                    Add a product
                </a>

                <a asp-controller="Home"
                   asp-action="Menu"
                   class="btn-hero-outline">
                    <i class="bi bi-eye"></i>
                    View customer menu
                </a>
            </div>
        </div>

        <div class="hero-decoration">
            <i class="bi bi-cup-hot"></i>
        </div>
    </section>

    <!-- Management tools -->
    <section>
        <div class="section-heading">
            <div>
                <div class="section-kicker">Your workspace</div>
                <h3>Manage your café</h3>
                <p>Choose an area to manage or update.</p>
            </div>
        </div>

        <div class="row g-4">

            <!-- Products -->
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="Product"
                   asp-action="ProductList"
                   class="management-card">
                    <div class="management-card-top">
                        <div class="management-icon icon-brown">
                            <i class="bi bi-cup-hot"></i>
                        </div>
                        <i class="bi bi-arrow-up-right card-arrow"></i>
                    </div>

                    <h4>Products</h4>
                    <p>
                        Add new items, update prices, change descriptions
                        and manage product images.
                    </p>

                    <span class="card-link">
                        MANAGE PRODUCTS
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </a>
            </div>

            <!-- Categories -->
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="Category"
                   asp-action="Index"
                   class="management-card">
                    <div class="management-card-top">
                        <div class="management-icon icon-green">
                            <i class="bi bi-grid"></i>
                        </div>
                        <i class="bi bi-arrow-up-right card-arrow"></i>
                    </div>

                    <h4>Categories</h4>
                    <p>
                        Create and organise sections such as coffee,
                        desserts, pastries and seasonal specials.
                    </p>

                    <span class="card-link">
                        MANAGE CATEGORIES
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </a>
            </div>

            <!-- PDF menu -->

            <div class="col-sm-6 col-xl-3">
                <button type="button"
                        class="management-card management-card-button"
                        data-bs-toggle="modal"
                        data-bs-target="#menuPdfModal">

                    <div class="management-card-top">
                        <div class="management-icon icon-rose">
                            <i class="bi bi-file-earmark-pdf"></i>
                        </div>
                        <i class="bi bi-arrow-up-right card-arrow"></i>
                    </div>

                    <h4>PDF Menu</h4>
                    <p>
                        Upload a menu document, preview the current menu,
                        download it or replace an older version.
                    </p>

                    <span class="card-link">
                        MANAGE MENU
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </button>
            </div>

            <!-- Settings -->
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="Settings"
                   asp-action="Index"
                   class="management-card">
                    <div class="management-card-top">
                        <div class="management-icon icon-blue">
                            <i class="bi bi-sliders"></i>
                        </div>
                        <i class="bi bi-arrow-up-right card-arrow"></i>
                    </div>

                    <h4>Settings</h4>
                    <p>
                        Manage your owner profile and the administration
                        preferences available for your account.
                    </p>

                    <span class="card-link">
                        VIEW SETTINGS
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </a>
            </div>

        </div>
    </section>

    <!-- Lower dashboard -->
    <section class="row g-4 bottom-grid">

        <div class="col-lg-7">
            <div class="panel">
                <div class="section-kicker">A simple workflow</div>
                <h3 class="panel-title">Keep your menu in shape</h3>
                <p class="panel-subtitle">
                    A simple way to keep your online café menu organised.
                </p>

                <div class="workflow-item">
                    <div class="workflow-number">01</div>
                    <div>
                        <h5>Create your categories</h5>
                        <p>
                            Organise your menu into clear sections so customers
                            can find what they want.
                        </p>
                    </div>
                </div>

                <div class="workflow-item">
                    <div class="workflow-number">02</div>
                    <div>
                        <h5>Add your products</h5>
                        <p>
                            Give every item a name, description, price and
                            optional image.
                        </p>
                    </div>
                </div>

                <div class="workflow-item">
                    <div class="workflow-number">03</div>
                    <div>
                        <h5>Check the customer menu</h5>
                        <p>
                            Review how your products appear on the public
                            website after saving your changes.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="preview-panel">
                <div class="preview-overline">The customer experience</div>

                <h4>Your menu is part<br />of your café's story.</h4>

                <p>
                    A welcoming online menu helps customers explore your
                    drinks, discover something new and learn more about
                    Café Serenity.
                </p>

                <a asp-controller="Home"
                   asp-action="Menu"
                   class="preview-link">
                    <i class="bi bi-arrow-up-right"></i>
                    Explore the customer menu
                </a>
            </div>
        </div>


        <!-- PDF Menu Modal -->
        <div class="modal fade"
             id="menuPdfModal"
             tabindex="-1"
             aria-labelledby="menuPdfModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content"
                     style="border:0; border-radius:18px; overflow:hidden;">

                    <div class="modal-header"
                         style="background:#30221d; color:#fff7f0; padding:22px 26px;">

                        <div>
                            <div style="color:#c5a58b; font-size:10px;
                                letter-spacing:2px; font-weight:800;
                                text-transform:uppercase; margin-bottom:6px;">
                                Café Serenity
                            </div>

                            <h5 class="modal-title"
                                id="menuPdfModalLabel"
                                style="font-weight:750; margin:0;">
                                Manage PDF Menu
                            </h5>
                        </div>

                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <div class="modal-body" style="padding:26px; background:#faf8f5;">

                        @if (TempData["MenuError"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["MenuError"]
                            </div>
                        }

                        @if (ViewBag.HasMenu == true)
                        {
                            <div class="d-flex justify-content-between
                                        align-items-center gap-3 flex-wrap mb-3">

                                <div>
                                    <h6 style="color:#35251e; font-weight:750; margin-bottom:5px;">
                                        Current menu
                                    </h6>
                                    <p style="color:#8b8179; font-size:13px; margin:0;">
                                        Your latest uploaded PDF is shown below.
                                    </p>
                                </div>

                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-controller="Owner"
                                       asp-action="DownloadMenu"
                                       class="btn btn-sm"
                                       style="background:#76513e; color:white;
                                              padding:9px 13px; border-radius:8px;">
                                        <i class="bi bi-download"></i> Download PDF
                                    </a>

                                    <form asp-controller="Owner"
                                          asp-action="RemoveMenu"
                                          method="post"
                                          onsubmit="return confirm('Remove the current PDF menu? This cannot be undone.');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                style="padding:9px 13px; border-radius:8px;">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <iframe src="@Url.Action("PreviewMenu", "Owner")"
                                    title="Current Café Serenity PDF menu"
                                    style="width:100%; height:420px; border:1px solid #e8dfd5;
                                           border-radius:10px; background:white;">
                            </iframe>
                        }
                        else
                        {
                            <div class="text-center"
                                 style="padding:25px 15px 30px; background:white;
                                        border:1px dashed #d9c5b3; border-radius:12px;">

                                <div style="font-size:38px; color:#a77b5d; margin-bottom:10px;">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </div>

                                <h6 style="font-weight:750; color:#35251e;">
                                    No PDF menu uploaded yet
                                </h6>

                                <p style="color:#8b8179; font-size:13px; margin-bottom:0;">
                                    Upload your café's menu PDF below to get started.
                                </p>
                            </div>
                        }

                        <hr style="border-color:#e8dfd5; margin:24px 0;" />

                        <h6 style="font-weight:750; color:#35251e; margin-bottom:7px;">
                            @(ViewBag.HasMenu == true ? "Replace menu PDF" : "Upload menu PDF")
                        </h6>

                        <p style="font-size:12px; color:#8b8179; margin-bottom:15px;">
                            Choose a PDF file up to 10 MB.
                            @(ViewBag.HasMenu == true
                                                        ? "Uploading a new file will replace the current menu."
                                                        : "Your uploaded file will become the current menu.")
                        </p>

                        <form asp-controller="Owner"
                              asp-action="UploadMenu"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <input type="file"
                                       name="menuFile"
                                       class="form-control"
                                       accept=".pdf,application/pdf"
                                       required />
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button"
                                        class="btn btn-light"
                                        data-bs-dismiss="modal">
                                    Cancel
                                </button>

                                <button type="submit"
                                        class="btn"
                                        style="background:#76513e; color:white;
                                       padding:10px 17px; border-radius:8px;
                                       font-weight:700;">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                    @(ViewBag.HasMenu == true ? "Upload Replacement" : "Upload Menu")
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>

    </section>
    ca
    <footer class="dashboard-footer">
        <span>© @DateTime.Now.Year Café Serenity</span>
        <span>Made with care, one cup at a time.</span>
    </footer>

</div>

<script>
    (() => {
        const dateElement = document.getElementById("dashboardDate");

        if (dateElement) {
            dateElement.textContent = new Intl.DateTimeFormat("en-ZA", {
                weekday: "short",
                day: "numeric",
                month: "short",
                year: "numeric"
            }).format(new Date());
        }
    })();
</script>