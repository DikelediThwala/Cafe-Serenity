@* Views/Shared/_OwnerLayout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Café Serenity Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        #sidebar {
            width: 220px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: #343a40;
            color: white;
            transition: width 0.3s;
            overflow-y: auto;
            z-index: 1030;
            display: flex;
            flex-direction: column;
            padding: 1rem;
        }

            #sidebar.collapsed {
                width: 60px;
            }

            #sidebar .navbar-brand {
                font-weight: bold;
                color: white;
                text-align: center;
                margin-bottom: 0.5rem;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            #sidebar.collapsed .navbar-brand {
                font-size: 0; /* hide text when collapsed */
                margin-bottom: 0;
            }

            #sidebar .logo {
                display: block;
                margin: 0 auto 1rem auto;
                max-width: 220px;
                max-height: 120px;
                object-fit: contain;
                transition: max-width 0.3s, max-height 0.3s;
            }

            #sidebar.collapsed .logo {
                max-width: 40px;
                max-height: 40px;
                margin-bottom: 1rem;
            }

            #sidebar ul.nav-pills {
                flex-grow: 1;
            }

            #sidebar .nav-link {
                color: white;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                display: flex;
                align-items: center;
                padding: 0.5rem 0.75rem;
            }

                #sidebar .nav-link i {
                    font-size: 1.2rem;
                    width: 24px;
                    min-width: 24px;
                }

            #sidebar.collapsed .nav-link span {
                display: none; /* hide text */
            }

            #sidebar .nav-link.active {
                background-color: #495057;
            }

            #sidebar hr {
                border-color: rgba(255,255,255,0.1);
                margin: 1rem 0;
            }

            #sidebar .dropdown {
                margin-top: auto;
            }

            #sidebar .dropdown-toggle::after {
                display: none; /* hide caret */
            }

            #sidebar .dropdown .dropdown-menu {
                background-color: #343a40;
                border: none;
                margin-left: 60px;
            }

            #sidebar.collapsed .dropdown .dropdown-menu {
                margin-left: 0;
            }

            #sidebar .dropdown-item {
                color: white;
            }

                #sidebar .dropdown-item:hover {
                    background-color: #495057;
                }

        #content {
            margin-left: 220px;
            padding: 20px;
            flex-grow: 1;
            transition: margin-left 0.3s;
        }

            #content.expanded {
                margin-left: 60px;
            }

        /* Navbar top */
        nav.navbar {
            padding: 0.5rem 1rem;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <nav id="sidebar" class="d-flex flex-column">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand">
            Café Serenity Admin
        </a>
        <img src="~/images/logo.png" alt="Café Serenity Logo" class="logo" />

        <button id="sidebarToggle" type="button" aria-label="Toggle sidebar" style="background:none; border:none; color:white; font-size:1.5rem; padding: 0; margin-bottom: 1rem; cursor: pointer;">
            <i class="bi bi-list"></i>
        </button>

        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a asp-controller="Owner" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Owner" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-speedometer2 me-2"></i> <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a asp-controller="Product" asp-action="AddCoffee" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AddCoffee" ? "active" : "")">
                    <i class="bi bi-plus-square me-2"></i> <span>Add New Item</span>
                </a>
            </li>
            <li>
                <a asp-controller="Product" asp-action="ProductList" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ProductList" ? "active" : "")">
                    <i class="bi bi-card-list me-2"></i> <span>Products</span>
                </a>
            </li>
            <li>
                <a asp-controller="Product" asp-action="Orders" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "active" : "")">
                    <i class="bi bi-basket me-2"></i> <span>Orders</span>
                </a>
            </li>
            <li>
                <a asp-controller="Product" asp-action="Customers" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Customers" ? "active" : "")">
                    <i class="bi bi-people me-2"></i> <span>Customers</span>
                </a>
            </li>
            <li>
                <a asp-controller="Product" asp-action="Reports" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-line me-2"></i> <span>Reports</span>
                </a>
            </li>
            <li>
                <a asp-controller="Settings" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="bi bi-bar-chart-line me-2"></i><span>Settings</span>
                </a>
            </li>
        </ul>

        <hr />
        <div class="dropdown">
            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
               id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="https://via.placeholder.com/32" alt="owner" width="32" height="32" class="rounded-circle me-2" />
                <strong>Café Serenity</strong>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                <li><a asp-controller="Owner" asp-action="Profile" class="dropdown-item">Profile</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a asp-controller="Account" asp-action="Logout" class="dropdown-item">Logout</a></li>
            </ul>
        </div>
    </nav>

    <div id="content">
        <nav class="navbar navbar-expand navbar-light bg-light mb-4">
            <div class="container-fluid">
                <button id="sidebarToggle" type="button" aria-label="Toggle sidebar" style="
    background:none;
    border:none;
    color:white;
    font-size:1.2rem;
    width:24px;
    min-width:24px;
    padding-left:0.75rem;
    padding-right:0.75rem;
    margin-bottom:1rem;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:flex-start;
">
                    <i class="bi bi-list"></i>
                </button>


                <span class="navbar-text">
                    @ViewData["Title"]
                </span>
            </div>
        </nav>

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebar = document.getElementById('sidebar');
        const content = document.getElementById('content');
        const toggleBtns = document.querySelectorAll('#sidebarToggle');

        toggleBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                sidebar.classList.toggle('collapsed');
                content.classList.toggle('expanded');
            });
        });
    </script>

</body>
</html>
