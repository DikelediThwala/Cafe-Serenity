@model Coffee_Shop.Models.CoffeeProductViewModel

@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Add Item";
}

<style>
    .item-page {
        color: #34251f;
        padding: 10px 0 35px;
        font-family: inherit;
    }

    .item-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #a36c4e;
        text-transform: uppercase;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .item-heading h1 {
        font-size: clamp(26px, 3vw, 35px);
        font-weight: 800;
        letter-spacing: -1px;
        margin: 0 0 8px;
        color: #34251f;
    }

    .item-heading p {
        color: #897d75;
        margin: 0;
        font-size: 14px;
    }

    .back-link {
        color: #76503c;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        padding: 11px 15px;
        border: 1px solid #e7d9ce;
        border-radius: 10px;
        white-space: nowrap;
        background: #fffdfb;
    }

        .back-link:hover {
            background: #f5ebe3;
            color: #503427;
        }

    .item-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(260px, .85fr);
        gap: 24px;
        align-items: start;
    }

    .form-panel, .preview-panel {
        background: #fffdfb;
        border: 1px solid #eee3da;
        border-radius: 18px;
        box-shadow: 0 8px 28px rgba(63, 40, 27, .045);
        overflow: hidden;
    }

    .panel-heading {
        padding: 22px 25px;
        border-bottom: 1px solid #f0e7df;
    }

        .panel-heading h2 {
            color: #34251f;
            font-size: 17px;
            font-weight: 800;
            margin: 0 0 5px;
        }

        .panel-heading p {
            color: #94867d;
            font-size: 12px;
            margin: 0;
        }

    .form-content {
        padding: 25px;
    }

    .section-label {
        font-size: 11px;
        font-weight: 800;
        color: #a36c4e;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 18px;
    }

    .field-group {
        margin-bottom: 21px;
    }

        .field-group label {
            display: block;
            color: #4a3930;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 8px;
        }

            .field-group label .optional {
                color: #a79a91;
                font-weight: 400;
            }

    .item-page .form-control,
    .item-page .form-select {
        width: 100%;
        min-height: 46px;
        padding: 11px 13px;
        border: 1px solid #e6d9ce;
        border-radius: 10px;
        background-color: #fff;
        color: #34251f;
        font-size: 13px;
        box-shadow: none;
    }

    .item-page textarea.form-control {
        min-height: 112px;
        resize: vertical;
    }

    .item-page .form-control:focus,
    .item-page .form-select:focus {
        border-color: #a66c4e;
        box-shadow: 0 0 0 3px rgba(166, 108, 78, .12);
    }

    .field-hint {
        display: block;
        margin-top: 7px;
        color: #a0948b;
        font-size: 11px;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .price-wrap {
        position: relative;
    }

    .price-symbol {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #96725d;
        font-weight: 700;
        font-size: 13px;
    }

    .price-wrap input {
        padding-left: 34px !important;
    }

    .upload-zone {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 180px;
        padding: 22px;
        text-align: center;
        border: 1.5px dashed #d8c2b2;
        border-radius: 13px;
        background: #fcf7f2;
        cursor: pointer;
        transition: background .2s, border-color .2s;
    }

        .upload-zone:hover {
            background: #f7eee6;
            border-color: #a66c4e;
        }

    .upload-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        border-radius: 13px;
        background: #ead9cb;
        color: #76503c;
        font-size: 22px;
        margin-bottom: 12px;
    }

    .upload-zone strong {
        font-size: 13px;
        color: #50382b;
    }

    .upload-zone span {
        margin-top: 6px;
        color: #9a8a80;
        font-size: 11px;
    }

    .upload-zone input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .image-preview {
        display: none;
        width: 100%;
        max-height: 210px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 12px;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-top: 21px;
        margin-top: 8px;
        border-top: 1px solid #f0e7df;
    }

    .cancel-link {
        color: #83746a;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
    }

    .save-button {
        border: 0;
        border-radius: 10px;
        background: #50382b;
        color: white;
        padding: 13px 22px;
        font-size: 13px;
        font-weight: 700;
        transition: background .2s, transform .2s;
    }

        .save-button:hover {
            background: #76503c;
            transform: translateY(-1px);
        }

    .preview-top {
        background: #50382b;
        color: #fff8f1;
        padding: 22px;
    }

        .preview-top span {
            color: #d9b9a3;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .preview-top h2 {
            font-size: 18px;
            font-weight: 800;
            margin: 8px 0 0;
        }

    .menu-preview {
        padding: 20px;
    }

    .preview-image-wrap {
        position: relative;
        height: 190px;
        overflow: hidden;
        border-radius: 12px;
        background: #f1e6dc;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .preview-image-wrap img {
            display: none;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .preview-placeholder {
        text-align: center;
        color: #a58b78;
    }

        .preview-placeholder .cup {
            font-size: 42px;
            display: block;
            margin-bottom: 8px;
        }

        .preview-placeholder p {
            font-size: 11px;
            margin: 0;
        }

    .preview-category {
        display: inline-block;
        background: #f3e6db;
        color: #8d5e43;
        padding: 6px 10px;
        border-radius: 30px;
        font-size: 10px;
        font-weight: 800;
        margin-top: 18px;
    }

    .preview-product-name {
        color: #34251f;
        font-size: 19px;
        font-weight: 800;
        margin: 12px 0 7px;
        overflow-wrap: anywhere;
    }

    .preview-description {
        color: #8c7d73;
        font-size: 12px;
        line-height: 1.7;
        min-height: 40px;
        overflow-wrap: anywhere;
    }

    .preview-price-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid #f0e7df;
        padding-top: 16px;
        margin-top: 16px;
    }

    .preview-price {
        font-size: 20px;
        font-weight: 800;
        color: #50382b;
    }

    .preview-stock {
        color: #85766b;
        font-size: 11px;
    }

    .preview-note {
        margin-top: 16px;
        padding: 13px;
        background: #f8f1eb;
        color: #89776a;
        font-size: 11px;
        line-height: 1.6;
        border-radius: 10px;
    }

    .validation-message {
        color: #b42318;
        font-size: 11px;
        margin-top: 5px;
    }

    @@media (max-width: 1000px) {
        .item-layout {
            grid-template-columns: 1fr;
        }

        .preview-panel {
            max-width: none;
        }

        .preview-image-wrap {
            height: 240px;
        }
    }

    @@media (max-width: 600px) {
        .item-heading {
            flex-direction: column;
        }

        .form-content {
            padding: 18px;
        }

        .panel-heading {
            padding: 18px;
        }

        .field-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-actions {
            align-items: stretch;
            flex-direction: column-reverse;
        }

        .save-button {
            width: 100%;
        }

        .cancel-link {
            text-align: center;
            padding: 8px;
        }
    }
</style>

<div class="item-page">

    <div class="item-heading">
        <div>
            <div class="eyebrow">Menu management / Create</div>
            <h1>Add a new item</h1>
            <p>Add a product to your menu and manage its details in one place.</p>
        </div>

        <a asp-controller="Product"
           asp-action="ProductList"
           class="back-link">
            &larr; View all items
        </a>
    </div>

    <div class="item-layout">

        <div class="form-panel">
            <div class="panel-heading">
                <h2>Item information</h2>
                <p>Enter the details customers will see on your menu.</p>
            </div>

            <form asp-controller="Product"
                  asp-action="AddCoffee"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "validation-message" })

                <div class="form-content">

                    <div class="section-label">01 — Basic details</div>

                    <div class="field-group">
                        <label asp-for="ProductName">Item name</label>
                        <input asp-for="ProductName"
                               class="form-control"
                               id="ProductName"
                               placeholder="e.g. Caramel Latte or Chocolate Cake"
                               autocomplete="off" />
                        <span asp-validation-for="ProductName"
                              class="validation-message"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  id="Description"
                                  placeholder="Describe the ingredients, flavour or what makes this item special..."></textarea>
                        <span asp-validation-for="Description"
                              class="validation-message"></span>
                    </div>

                    <div class="field-row">
                        <div class="field-group">
                            <label asp-for="Category">Category</label>
                            <select asp-for="Category"
                                    class="form-select"
                                    id="Category">
                                <option value="">Select a category</option>
                                <option value="Espresso">Espresso</option>
                                <option value="Latte">Latte</option>
                                <option value="Cappuccino">Cappuccino</option>
                                <option value="Mocha">Mocha</option>
                                <option value="Iced Coffee">Iced Coffee</option>
                                <option value="Tea">Tea</option>
                                <option value="Matcha">Matcha</option>
                                <option value="Desserts">Desserts</option>
                                <option value="Breakfast">Breakfast</option>
                                <option value="Cold Drinks">Cold Drinks</option>
                                <option value="Family Special">Family Special</option>
                            </select>
                            <span asp-validation-for="Category"
                                  class="validation-message"></span>
                            <span class="field-hint">
                                More categories can be managed dynamically later.
                            </span>
                        </div>

                        <div class="field-group">
                            <label asp-for="Quantity">Available quantity</label>
                            <input asp-for="Quantity"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   id="Quantity"
                                   placeholder="e.g. 25" />
                            <span asp-validation-for="Quantity"
                                  class="validation-message"></span>
                        </div>
                    </div>

                    <div class="field-group">
                        <label asp-for="Price">Selling price</label>
                        <div class="price-wrap">
                            <span class="price-symbol">R</span>
                            <input asp-for="Price"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control"
                                   id="Price"
                                   placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price"
                              class="validation-message"></span>
                    </div>

                    <div class="section-label" style="margin-top: 28px;">
                        02 — Product photography
                    </div>

                    <div class="field-group">
                        <label asp-for="Image">
                            Item image <span class="optional">(optional)</span>
                        </label>

                        <label class="upload-zone" for="Image">
                            <img id="uploadPreview" class="image-preview" alt="Selected item image preview" />

                            <div id="uploadPrompt">
                                <div class="upload-icon">↑</div>
                                <strong>Choose an image to upload</strong>
                                <span>JPG, PNG or WebP works best</span>
                            </div>

                            <input asp-for="Image"
                                   type="file"
                                   id="Image"
                                   accept="image/png,image/jpeg,image/webp" />
                        </label>

                        <span asp-validation-for="Image"
                              class="validation-message"></span>
                        <span class="field-hint">
                            Use a clear image that shows customers what the item looks like.
                        </span>
                    </div>

                    <div class="form-actions">
                        <a asp-controller="Product"
                           asp-action="ProductList"
                           class="cancel-link">
                            Cancel
                        </a>

                        <button type="submit" class="save-button">
                            + Add Item
                        </button>
                    </div>

                </div>
            </form>
        </div>

        <aside class="preview-panel">
            <div class="preview-top">
                <span>Customer view</span>
                <h2>Menu item preview</h2>
            </div>

            <div class="menu-preview">
                <div class="preview-image-wrap">
                    <img id="menuPreviewImage" alt="Menu item preview" />

                    <div class="preview-placeholder" id="menuPlaceholder">
                        <span class="cup">☕</span>
                        <p>Your item image will appear here</p>
                    </div>
                </div>

                <span class="preview-category" id="previewCategory">
                    YOUR CATEGORY
                </span>

                <h3 class="preview-product-name" id="previewName">
                    Your item name
                </h3>

                <p class="preview-description" id="previewDescription">
                    Your item description will appear here when you start typing.
                </p>

                <div class="preview-price-row">
                    <span class="preview-price" id="previewPrice">R 0.00</span>
                    <span class="preview-stock" id="previewStock">Stock: 0</span>
                </div>

                <div class="preview-note">
                    This is a live preview to help you see how your item details
                    come together. Save the item to add it to your menu.
                </div>
            </div>
        </aside>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const nameInput = document.getElementById("ProductName");
        const descriptionInput = document.getElementById("Description");
        const priceInput = document.getElementById("Price");
        const quantityInput = document.getElementById("Quantity");
        const categoryInput = document.getElementById("Category");
        const imageInput = document.getElementById("Image");

        const previewName = document.getElementById("previewName");
        const previewDescription = document.getElementById("previewDescription");
        const previewPrice = document.getElementById("previewPrice");
        const previewStock = document.getElementById("previewStock");
        const previewCategory = document.getElementById("previewCategory");

        const menuImage = document.getElementById("menuPreviewImage");
        const menuPlaceholder = document.getElementById("menuPlaceholder");
        const uploadPreview = document.getElementById("uploadPreview");
        const uploadPrompt = document.getElementById("uploadPrompt");

        function updatePreview() {
            previewName.textContent = nameInput.value.trim() || "Your item name";
            previewDescription.textContent =
                descriptionInput.value.trim() ||
                "Your item description will appear here when you start typing.";

            const price = Number.parseFloat(priceInput.value);
            previewPrice.textContent =
                "R " + (Number.isFinite(price) ? price.toFixed(2) : "0.00");

            previewStock.textContent = "Stock: " + (quantityInput.value || "0");
            previewCategory.textContent =
                categoryInput.value || "YOUR CATEGORY";
        }

        [nameInput, descriptionInput, priceInput, quantityInput, categoryInput]
            .forEach(function (field) {
                field.addEventListener("input", updatePreview);
                field.addEventListener("change", updatePreview);
            });

        imageInput.addEventListener("change", function () {
            const file = imageInput.files[0];

            if (!file) {
                menuImage.removeAttribute("src");
                menuImage.style.display = "none";
                uploadPreview.style.display = "none";
                menuPlaceholder.style.display = "block";
                uploadPrompt.style.display = "block";
                return;
            }

            if (!file.type.startsWith("image/")) {
                imageInput.value = "";
                alert("Please choose an image file.");
                return;
            }

            const reader = new FileReader();

            reader.onload = function (event) {
                menuImage.src = event.target.result;
                menuImage.style.display = "block";
                menuPlaceholder.style.display = "none";

                uploadPreview.src = event.target.result;
                uploadPreview.style.display = "block";
                uploadPrompt.style.display = "none";
            };

            reader.readAsDataURL(file);
        });

        updatePreview();
    });
</script>