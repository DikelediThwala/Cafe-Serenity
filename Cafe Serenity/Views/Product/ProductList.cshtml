@model IEnumerable<Coffee_Shop.Models.Product>

@using System.Linq

@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Products";

    var products = Model?.ToList() ?? new List<Coffee_Shop.Models.Product>();
    var categories = products
        .Where(p => !string.IsNullOrWhiteSpace(p.Category))
        .Select(p => p.Category.Trim())
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    var totalProducts = products.Count;
    var inStock = products.Count(p => p.Quantity > 0);
    var outOfStock = products.Count(p => p.Quantity <= 0);
}

<style>
    .products-page {
        --coffee: #54392d;
        --coffee-dark: #35251e;
        --coffee-light: #846653;
        --cream: #faf7f1;
        --muted: #8b8178;
        --border: #eee7de;
        color: #302720;
        padding: 28px;
        min-height: 100vh;
        background: #faf8f4;
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .products-page * {
            box-sizing: border-box;
        }

        .products-page .page-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .products-page .eyebrow {
            color: #9a775d;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 11px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .products-page h1 {
            color: var(--coffee-dark);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(28px, 3vw, 37px);
            font-weight: 700;
            margin: 0 0 8px;
            letter-spacing: -0.8px;
        }

        .products-page .page-subtitle {
            color: var(--muted);
            font-size: 14px;
            margin: 0;
            line-height: 1.6;
        }

        .products-page .add-product-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 13px 19px;
            border-radius: 10px;
            background: var(--coffee);
            color: white;
            font-weight: 700;
            font-size: 13px;
            text-decoration: none;
            border: 1px solid var(--coffee);
            box-shadow: 0 5px 14px rgba(84, 57, 45, .12);
            transition: .2s ease;
        }

            .products-page .add-product-btn:hover {
                background: var(--coffee-dark);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 8px 18px rgba(84, 57, 45, .18);
            }

        .products-page .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 17px;
            margin-bottom: 28px;
        }

        .products-page .stat-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 21px;
            display: flex;
            align-items: center;
            gap: 15px;
            min-width: 0;
            box-shadow: 0 3px 12px rgba(58, 39, 27, .025);
        }

        .products-page .stat-icon {
            width: 49px;
            height: 49px;
            flex-shrink: 0;
            border-radius: 13px;
            display: grid;
            place-items: center;
            font-size: 23px;
            background: #f4ece3;
        }

            .products-page .stat-icon.green {
                background: #eaf4eb;
            }

            .products-page .stat-icon.red {
                background: #fbeceb;
            }

        .products-page .stat-label {
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 5px;
        }

        .products-page .stat-value {
            font-size: 25px;
            line-height: 1.2;
            color: var(--coffee-dark);
            font-weight: 750;
        }

        .products-page .catalog-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(58, 39, 27, .035);
        }

        .products-page .catalog-heading {
            padding: 23px 24px 19px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

            .products-page .catalog-heading h2 {
                font-size: 19px;
                font-weight: 750;
                color: var(--coffee-dark);
                margin: 0 0 5px;
            }

            .products-page .catalog-heading p {
                font-size: 12px;
                color: var(--muted);
                margin: 0;
            }

        .products-page .product-count {
            color: var(--coffee);
            background: #f5eee7;
            padding: 7px 11px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 750;
            white-space: nowrap;
        }

        .products-page .filters {
            display: flex;
            gap: 12px;
            padding: 0 24px 20px;
            flex-wrap: wrap;
        }

        .products-page .search-wrap {
            position: relative;
            flex: 1 1 250px;
        }

        .products-page .search-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9a8c80;
            pointer-events: none;
            font-size: 16px;
        }

        .products-page .search-input,
        .products-page .category-filter {
            width: 100%;
            min-height: 43px;
            border: 1px solid #e9e1d7;
            border-radius: 9px;
            background: #fffdfa;
            padding: 10px 13px;
            color: #35251e;
            font-size: 13px;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

        .products-page .search-input {
            padding-left: 39px;
        }

            .products-page .search-input:focus,
            .products-page .category-filter:focus {
                border-color: #a98a70;
                box-shadow: 0 0 0 3px rgba(169, 138, 112, .13);
            }

        .products-page .category-filter {
            flex: 0 1 205px;
            cursor: pointer;
        }

        .products-page .table-scroll {
            width: 100%;
            overflow-x: auto;
            border-top: 1px solid var(--border);
        }

        .products-page .product-table {
            width: 100%;
            min-width: 850px;
            border-collapse: separate;
            border-spacing: 0;
            margin: 0;
        }

            .products-page .product-table thead th {
                background: #fcfaf7;
                color: #928579;
                text-transform: uppercase;
                letter-spacing: 1px;
                font-size: 10px;
                font-weight: 800;
                padding: 14px 18px;
                border-bottom: 1px solid var(--border);
                white-space: nowrap;
            }

            .products-page .product-table tbody td {
                padding: 16px 18px;
                border-bottom: 1px solid #f1ece5;
                vertical-align: middle;
                font-size: 13px;
            }

            .products-page .product-table tbody tr {
                transition: background .15s ease;
            }

                .products-page .product-table tbody tr:hover {
                    background: #fdfbf8;
                }

                .products-page .product-table tbody tr:last-child td {
                    border-bottom: 0;
                }

        .products-page .product-image {
            width: 62px;
            height: 62px;
            border-radius: 12px;
            object-fit: cover;
            display: block;
            border: 1px solid #eee5db;
            background: #f7f1e9;
        }

        .products-page .no-image {
            width: 62px;
            height: 62px;
            border-radius: 12px;
            background: #f5eee6;
            display: grid;
            place-items: center;
            color: #a58a72;
            font-size: 23px;
        }

        .products-page .product-name {
            font-size: 13px;
            color: #39291f;
            font-weight: 750;
            margin-bottom: 5px;
            min-width: 155px;
        }

        .products-page .product-description {
            color: #8b8178;
            font-size: 11px;
            line-height: 1.55;
            max-width: 270px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .products-page .product-id {
            color: #a0958a;
            font-size: 12px;
            font-weight: 700;
        }

        .products-page .price {
            color: var(--coffee-dark);
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
        }

        .products-page .category-badge {
            display: inline-block;
            padding: 6px 9px;
            border-radius: 7px;
            color: #76553e;
            background: #f5eee6;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .products-page .stock-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 20px;
            padding: 6px 9px;
            font-size: 11px;
            font-weight: 750;
            white-space: nowrap;
        }

            .products-page .stock-badge::before {
                content: "";
                display: inline-block;
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
            }

        .products-page .stock-good {
            color: #34754a;
            background: #eaf5ec;
        }

        .products-page .stock-low {
            color: #98651a;
            background: #fff3d9;
        }

        .products-page .stock-empty {
            color: #b3443d;
            background: #fceceb;
        }

        .products-page .actions {
            display: flex;
            gap: 7px;
            align-items: center;
        }

        .products-page .action-btn {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            padding: 8px 11px;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 750;
            text-decoration: none;
            transition: .18s ease;
            white-space: nowrap;
        }

        .products-page .edit-btn {
            color: #725137;
            background: #f5eee5;
            border: 1px solid #eee1d2;
        }

            .products-page .edit-btn:hover {
                background: #ead8c4;
                color: #4b3224;
            }

        .products-page .delete-btn {
            color: #ad4841;
            background: #fff1ef;
            border: 1px solid #f7dedb;
        }

            .products-page .delete-btn:hover {
                background: #f9dedb;
                color: #8d2d27;
            }

        .products-page .empty-state {
            text-align: center;
            padding: 55px 20px !important;
            color: #8b8178;
        }

        .products-page .empty-icon {
            font-size: 38px;
            margin-bottom: 12px;
        }

        .products-page .empty-state h3 {
            color: var(--coffee-dark);
            font-size: 18px;
            margin-bottom: 7px;
        }

        .products-page .empty-state p {
            font-size: 13px;
            margin-bottom: 18px;
        }

        .products-page .no-results {
            display: none;
        }

        .products-page .catalog-footer {
            padding: 14px 24px;
            border-top: 1px solid var(--border);
            background: #fffdfa;
            color: #928579;
            font-size: 11px;
        }

        .products-page .success-message {
            border: 1px solid #cfe7d3;
            background: #eef8ef;
            color: #2f6e40;
            padding: 13px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 13px;
        }

    @@media (max-width: 900px) {
        .products-page {
            padding: 22px 16px;
        }

            .products-page .stats-grid {
                gap: 10px;
            }

            .products-page .stat-card {
                padding: 15px;
                gap: 10px;
            }

            .products-page .stat-icon {
                width: 40px;
                height: 40px;
                font-size: 19px;
            }

            .products-page .stat-value {
                font-size: 22px;
            }
    }

    @@media (max-width: 600px) {
        .products-page {
            padding: 18px 12px;
        }

            .products-page .stats-grid {
                grid-template-columns: 1fr;
            }

            .products-page .stat-card {
                padding: 14px 16px;
            }

            .products-page .catalog-heading {
                padding: 19px 16px;
            }

            .products-page .filters {
                padding: 0 16px 17px;
            }

            .products-page .category-filter {
                flex: 1 1 100%;
            }
    }
</style>

<div class="products-page">

    <div class="page-top">
        <div>
            <div class="eyebrow">Café Serenity / Menu Management</div>
            <h1>Our Products</h1>
            <p class="page-subtitle">
                Manage your menu, keep track of stock, and update your café offerings.
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="AddCoffee"
           class="add-product-btn">
            <span style="font-size:18px;">+</span>
            Add Item
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message" role="status">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">☕</div>
            <div>
                <div class="stat-label">Total Menu Items</div>
                <div class="stat-value">@totalProducts</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">✓</div>
            <div>
                <div class="stat-label">Items In Stock</div>
                <div class="stat-value">@inStock</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon red">!</div>
            <div>
                <div class="stat-label">Out of Stock</div>
                <div class="stat-value">@outOfStock</div>
            </div>
        </div>
    </div>

    <section class="catalog-card">
        <div class="catalog-heading">
            <div>
                <h2>Menu Inventory</h2>
                <p>View and manage every item available in your café.</p>
            </div>

            <span class="product-count">
                @totalProducts @(totalProducts == 1 ? "ITEM" : "ITEMS")
            </span>
        </div>

        <div class="filters">
            <div class="search-wrap">
                <span class="search-icon">⌕</span>
                <input type="search"
                       id="productSearch"
                       class="search-input"
                       placeholder="Search by item name or description..."
                       aria-label="Search products" />
            </div>

            <select id="categoryFilter"
                    class="category-filter"
                    aria-label="Filter by category">
                <option value="">All categories</option>
                @foreach (var category in categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>

        <div class="table-scroll">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Product Details</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="productTableBody">
                    @if (products.Any())
                    {
                        foreach (var item in products)
                        {
                            var categoryName = item.Category?.Trim() ?? "";
                            var description = item.Description ?? "";
                            var name = item.ProductName ?? "";

                            var stockClass = item.Quantity <= 0
                            ? "stock-empty"
                            : item.Quantity <= 5
                            ? "stock-low"
                            : "stock-good";

                            var stockLabel = item.Quantity <= 0
                            ? "Out of stock"
                            : item.Quantity <= 5
                            ? "Low stock"
                            : "In stock";

                            <tr class="product-row"
                                data-name="@name.ToLowerInvariant()"
                                data-description="@description.ToLowerInvariant()"
                                data-category="@categoryName.ToLowerInvariant()">

                                <td>
                                    <span class="product-id">#@item.ProductId</span>
                                </td>

                                <td>
                                    @if (item.Image != null && item.Image.Length > 0)
                                    {
                                        var base64 = Convert.ToBase64String(item.Image);
                                        var imgSrc = $"data:image/png;base64,{base64}";

                                        <img src="@imgSrc"
                                             alt="@name"
                                             class="product-image" />
                                    }
                                    else
                                    {
                                        <div class="no-image" title="No product image">☕</div>
                                    }
                        </td>

                        <td>
                            <div class="product-name">@item.ProductName</div>
                            <div class="product-description">@item.Description</div>
                        </td>

                        <td>
                            <span class="category-badge">
                                @(string.IsNullOrWhiteSpace(item.Category)
                                                                ? "Uncategorised"
                                                                : item.Category)
                            </span>
                        </td>

                                <td>
                                    <span class="price">R @item.Price.ToString("N2")</span>
                                </td>

                                <td>
                                    <span class="stock-badge @stockClass">
                                        @stockLabel · @item.Quantity
                                    </span>
                                </td>

                                <td>
                                    <div class="actions">
                                        <a asp-controller="Product"
                                           asp-action="Edit"
                                           asp-route-id="@item.ProductId"
                                           class="action-btn edit-btn">
                                            Edit
                                        </a>

                                        <a asp-controller="Product"
                                           asp-action="Delete"
                                           asp-route-id="@item.ProductId"
                                           class="action-btn delete-btn">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <div class="empty-icon">☕</div>
                                <h3>Your menu is waiting</h3>
                                <p>You haven't added any products yet. Add your first menu item to get started.</p>
                                <a asp-controller="Product"
                                   asp-action="AddCoffee"
                                   class="add-product-btn">
                                    + Add Your First Item
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="noSearchResults" class="empty-state no-results">
                <div class="empty-icon">⌕</div>
                <h3>No matching products</h3>
                <p>Try another search term or select a different category.</p>
            </div>
        </div>

        <div class="catalog-footer">
            Showing <strong id="visibleCount">@totalProducts</strong>
            of @totalProducts menu items
        </div>
    </section>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("productSearch");
        const categoryFilter = document.getElementById("categoryFilter");
        const rows = Array.from(document.querySelectorAll(".product-row"));
        const visibleCount = document.getElementById("visibleCount");
        const noResults = document.getElementById("noSearchResults");

        function filterProducts() {
            const searchTerm = searchInput.value.trim().toLowerCase();
            const selectedCategory = categoryFilter.value.trim().toLowerCase();
            let visible = 0;

            rows.forEach(function (row) {
                const name = row.dataset.name || "";
                const description = row.dataset.description || "";
                const category = row.dataset.category || "";

                const matchesSearch =
                    name.includes(searchTerm) ||
                    description.includes(searchTerm);

                const matchesCategory =
                    selectedCategory === "" ||
                    category === selectedCategory;

                const show = matchesSearch && matchesCategory;

                row.style.display = show ? "" : "none";

                if (show) {
                    visible++;
                }
            });

            visibleCount.textContent = visible;
            noResults.style.display =
                rows.length > 0 && visible === 0 ? "block" : "none";
        }

        searchInput.addEventListener("input", filterProducts);
        categoryFilter.addEventListener("change", filterProducts);
    });
</script>