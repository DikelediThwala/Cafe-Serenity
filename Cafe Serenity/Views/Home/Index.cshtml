@{
    ViewData["Title"] = "Home | Café Serenity";
}

<style>
    /* =========================================
               CAFÉ SERENITY — HOME PAGE
            ========================================= */

    .serenity-home {
        --espresso: #39251f;
        --coffee: #704735;
        --caramel: #c49a6c;
        --cream: #faf6f0;
        --white: #fffdf9;
        --muted: #84766c;
        --line: #e9ded2;
        color: var(--espresso);
        background: var(--cream);
        font-family: "Segoe UI", sans-serif;
        overflow: hidden;
        margin: -16px -12px 0;
    }

        .serenity-home *,
        .serenity-home *::before,
        .serenity-home *::after {
            box-sizing: border-box;
        }

        .serenity-home a {
            text-decoration: none;
        }

        .serenity-home img {
            max-width: 100%;
        }

        .serenity-home .section-shell {
            width: min(1160px, calc(100% - 48px));
            margin: 0 auto;
        }

        .serenity-home .section-padding {
            padding: 95px 0;
        }

        .serenity-home .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--coffee);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: .72rem;
            font-weight: 750;
            margin-bottom: 17px;
        }

            .serenity-home .eyebrow::before {
                content: "";
                width: 27px;
                height: 1px;
                background: var(--caramel);
            }

        .serenity-home .section-title {
            color: var(--espresso);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(2.2rem, 4vw, 3.4rem);
            line-height: 1.13;
            letter-spacing: -.8px;
            font-weight: 500;
            margin: 0 0 20px;
        }

        .serenity-home .section-description {
            color: var(--muted);
            font-size: 1rem;
            line-height: 1.9;
            max-width: 600px;
            margin: 0;
        }

        .serenity-home .serenity-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            padding: 15px 24px;
            border-radius: 4px;
            border: 1px solid var(--espresso);
            background: var(--espresso);
            color: #fffaf4;
            font-size: .88rem;
            font-weight: 650;
            transition: background .25s ease, color .25s ease, transform .25s ease, border-color .25s ease;
        }

            .serenity-home .serenity-btn:hover {
                background: var(--coffee);
                border-color: var(--coffee);
                color: white;
                transform: translateY(-2px);
            }

        .serenity-home .serenity-btn-outline {
            background: transparent;
            color: var(--espresso);
        }

            .serenity-home .serenity-btn-outline:hover {
                background: var(--espresso);
                color: white;
            }

    /* =========================================
               HERO
            ========================================= */

    .serenity-hero {
        position: relative;
        isolation: isolate;
        min-height: 650px;
        display: flex;
        align-items: center;
        color: white;
        background-color: var(--espresso);
        background-image: linear-gradient( 90deg, rgba(31, 19, 15, .90) 0%, rgba(31, 19, 15, .72) 43%, rgba(31, 19, 15, .20) 100% ), url("https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&fit=crop&w=2000&q=85");
        background-size: cover;
        background-position: center;
    }

        .serenity-hero::after {
            content: "";
            position: absolute;
            inset: auto 0 0;
            height: 100px;
            background: linear-gradient(transparent, rgba(31, 19, 15, .2));
            z-index: -1;
            pointer-events: none;
        }

    .serenity-hero-content {
        width: min(1160px, calc(100% - 48px));
        margin: 0 auto;
        padding: 100px 0 115px;
    }

    .serenity-hero .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: #e8c79f;
        font-size: .75rem;
        letter-spacing: 3.5px;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 25px;
    }

        .serenity-hero .hero-eyebrow i {
            font-size: 1rem;
        }

    .serenity-hero h1 {
        color: #fffaf3;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.4rem, 7.7vw, 6.6rem);
        font-weight: 500;
        line-height: .99;
        letter-spacing: -2px;
        max-width: 760px;
        margin: 0 0 25px;
    }

        .serenity-hero h1 em {
            color: #e5bd91;
            font-weight: 400;
        }

    .serenity-hero .hero-description {
        color: rgba(255, 250, 243, .85);
        max-width: 510px;
        font-size: 1.04rem;
        line-height: 1.9;
        margin: 0 0 32px;
    }

    .serenity-hero .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 13px;
    }

    .serenity-hero .serenity-btn {
        border-color: #e5bd91;
        background: #e5bd91;
        color: var(--espresso);
    }

        .serenity-hero .serenity-btn:hover {
            background: #f2d5b4;
            border-color: #f2d5b4;
            color: var(--espresso);
        }

    .serenity-hero .serenity-btn-outline {
        border-color: rgba(255, 250, 243, .7);
        background: rgba(255, 255, 255, .03);
        color: #fffaf3;
    }

        .serenity-hero .serenity-btn-outline:hover {
            background: #fffaf3;
            color: var(--espresso);
        }

    .hero-bottom-note {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 54px;
        color: rgba(255, 250, 243, .72);
        font-size: .78rem;
        letter-spacing: .5px;
    }

        .hero-bottom-note i {
            color: #e5bd91;
        }

    /* =========================================
               INTRO STRIP
            ========================================= */

    .serenity-intro-strip {
        background: var(--white);
        border-bottom: 1px solid var(--line);
    }

    .serenity-intro-inner {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        padding: 27px 0;
    }

    .serenity-intro-item {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 13px;
        padding: 10px 18px;
        border-right: 1px solid var(--line);
    }

        .serenity-intro-item:last-child {
            border-right: none;
        }

    .serenity-intro-icon {
        color: var(--caramel);
        font-size: 1.35rem;
    }

    .serenity-intro-item strong {
        display: block;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1rem;
        font-weight: 600;
    }

    .serenity-intro-item span {
        display: block;
        color: var(--muted);
        font-size: .78rem;
        margin-top: 3px;
    }

    /* =========================================
               FEATURED CATEGORIES
            ========================================= */

    .serenity-categories {
        background: var(--cream);
    }

    .serenity-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 25px;
        margin-bottom: 42px;
    }

        .serenity-section-heading .section-description {
            max-width: 440px;
        }

    .serenity-category-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 23px;
    }

    .serenity-category-card {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: end;
        min-height: 385px;
        overflow: hidden;
        background: #d7c1ac;
        color: white;
        isolation: isolate;
    }

        .serenity-category-card::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            background-size: cover;
            background-position: center;
            transition: transform .6s ease;
        }

        .serenity-category-card:hover::before {
            transform: scale(1.06);
        }

        .serenity-category-card::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background: linear-gradient( 180deg, rgba(28, 17, 13, .02) 15%, rgba(28, 17, 13, .28) 48%, rgba(28, 17, 13, .91) 100% );
        }

    .serenity-category-coffee::before {
        background-image: url("https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=900&q=85");
    }

    .serenity-category-dessert::before {
        background-image: url("https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=900&q=85");
    }

    .serenity-category-pastry::before {
        background-image: url("https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=900&q=85");
    }

    .serenity-category-content {
        padding: 30px;
    }

    .serenity-category-number {
        display: inline-block;
        color: #efd0ab;
        font-size: .72rem;
        letter-spacing: 2px;
        margin-bottom: 13px;
    }

    .serenity-category-card h3 {
        color: white;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        font-weight: 500;
        margin: 0 0 10px;
    }

    .serenity-category-card p {
        color: rgba(255, 255, 255, .82);
        font-size: .9rem;
        line-height: 1.7;
        margin: 0 0 20px;
        max-width: 270px;
    }

    .serenity-category-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #f0cc9f;
        font-size: .85rem;
        font-weight: 700;
    }

        .serenity-category-link i {
            transition: transform .2s ease;
        }

        .serenity-category-link:hover {
            color: white;
        }

            .serenity-category-link:hover i {
                transform: translateX(5px);
            }

    /* =========================================
               ABOUT US
            ========================================= */

    .serenity-about {
        background: var(--white);
    }

    .serenity-about-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, .95fr);
        align-items: center;
        gap: 85px;
    }

    .serenity-about-copy .section-description + .section-description {
        margin-top: 17px;
    }

    .serenity-about-image-wrap {
        position: relative;
        padding: 0 0 22px 22px;
    }

        .serenity-about-image-wrap::before {
            content: "";
            position: absolute;
            inset: 22px 22px 0 0;
            border: 1px solid var(--caramel);
        }

    .serenity-about-image {
        position: relative;
        display: block;
        width: 100%;
        height: 490px;
        object-fit: cover;
        background: #e9ded2;
    }

    .serenity-about-stamp {
        position: absolute;
        left: -25px;
        bottom: 48px;
        width: 130px;
        height: 130px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background: var(--espresso);
        color: #f5d9b7;
        border: 5px solid var(--white);
        text-align: center;
        padding: 12px;
    }

        .serenity-about-stamp i {
            font-size: 1.5rem;
            margin-bottom: 8px;
        }

        .serenity-about-stamp span {
            font-family: Georgia, "Times New Roman", serif;
            font-size: .86rem;
            line-height: 1.4;
        }

    .serenity-about-points {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin: 30px 0;
        padding-top: 24px;
        border-top: 1px solid var(--line);
    }

    .serenity-about-point {
        display: flex;
        align-items: start;
        gap: 12px;
    }

        .serenity-about-point i {
            color: var(--caramel);
            margin-top: 4px;
        }

        .serenity-about-point strong {
            display: block;
            font-family: Georgia, "Times New Roman", serif;
            font-size: .98rem;
        }

        .serenity-about-point span {
            display: block;
            color: var(--muted);
            font-size: .8rem;
            line-height: 1.6;
            margin-top: 5px;
        }

    /* =========================================
               REVIEWS
            ========================================= */

    .serenity-reviews {
        position: relative;
        background: #f0e5d8;
        text-align: center;
    }

        .serenity-reviews .section-shell {
            max-width: 800px;
        }

        .serenity-reviews .eyebrow {
            justify-content: center;
        }

        .serenity-reviews .section-title {
            margin-bottom: 17px;
        }

    .serenity-review-decoration {
        color: var(--caramel);
        font-size: 2rem;
        margin-bottom: 20px;
    }

    .serenity-reviews .section-description {
        margin: 0 auto;
    }

    .serenity-review-note {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        padding: 12px 18px;
        border: 1px solid #deccb8;
        color: var(--coffee);
        font-size: .82rem;
    }

    /* =========================================
               LOCATION
            ========================================= */

    .serenity-location {
        background: var(--cream);
    }

    .serenity-location-grid {
        display: grid;
        grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
        gap: 60px;
        align-items: center;
    }

    .serenity-location-details {
        margin: 30px 0;
    }

    .serenity-location-item {
        display: flex;
        align-items: start;
        gap: 16px;
        padding: 17px 0;
        border-bottom: 1px solid var(--line);
    }

        .serenity-location-item:first-child {
            border-top: 1px solid var(--line);
        }

    .serenity-location-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #eee0cf;
        color: var(--coffee);
    }

    .serenity-location-item strong {
        display: block;
        font-size: .9rem;
        margin: 2px 0 6px;
    }

    .serenity-location-item p {
        color: var(--muted);
        font-size: .88rem;
        line-height: 1.7;
        margin: 0;
    }

    .serenity-map {
        position: relative;
        overflow: hidden;
        min-height: 420px;
        background: #e9ded2;
        border: 8px solid var(--white);
        box-shadow: 0 12px 40px rgba(57, 37, 31, .09);
    }

        .serenity-map iframe {
            display: block;
            width: 100%;
            min-height: 420px;
            height: 100%;
            border: 0;
        }

    /* =========================================
               FINAL CALL TO ACTION
            ========================================= */

    .serenity-cta {
        position: relative;
        padding: 76px 0;
        background: var(--espresso);
        color: #fffaf3;
        text-align: center;
    }

        .serenity-cta .eyebrow {
            color: #e5bd91;
            justify-content: center;
        }

        .serenity-cta .section-title {
            color: #fffaf3;
            max-width: 650px;
            margin: 0 auto 17px;
        }

        .serenity-cta .section-description {
            color: rgba(255, 250, 243, .72);
            margin: 0 auto 27px;
        }

        .serenity-cta .serenity-btn {
            background: #e5bd91;
            color: var(--espresso);
            border-color: #e5bd91;
        }

            .serenity-cta .serenity-btn:hover {
                background: #f2d5b4;
                border-color: #f2d5b4;
            }

    /* =========================================
               RESPONSIVE DESIGN
            ========================================= */

    @@media (max-width: 991.98px) {
        .serenity-home .section-padding {
            padding: 75px 0;
        }

        .serenity-hero {
            min-height: 590px;
        }

        .serenity-section-heading {
            align-items: start;
            flex-direction: column;
        }

        .serenity-category-grid {
            gap: 16px;
        }

        .serenity-category-card {
            min-height: 340px;
        }

        .serenity-category-content {
            padding: 22px;
        }

        .serenity-about-grid {
            gap: 45px;
        }

        .serenity-about-image {
            height: 420px;
        }

        .serenity-location-grid {
            gap: 35px;
        }
    }

    @@media (max-width: 767.98px) {
        .serenity-home .section-shell,
        .serenity-hero-content {
            width: calc(100% - 36px);
        }

        .serenity-hero {
            min-height: 580px;
            background-position: 58% center;
        }

        .serenity-hero-content {
            padding: 85px 0;
        }

        .serenity-hero h1 {
            font-size: clamp(3.2rem, 11vw, 5rem);
            letter-spacing: -1px;
        }

        .serenity-intro-inner {
            grid-template-columns: 1fr;
            padding: 12px 0;
        }

        .serenity-intro-item {
            justify-content: start;
            padding: 16px 8px;
            border-right: none;
            border-bottom: 1px solid var(--line);
        }

            .serenity-intro-item:last-child {
                border-bottom: none;
            }

        .serenity-category-grid {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .serenity-category-card {
            min-height: 380px;
        }

        .serenity-about-grid {
            grid-template-columns: 1fr;
            gap: 45px;
        }

        .serenity-about-image-wrap {
            margin-left: 18px;
        }

        .serenity-about-image {
            height: 400px;
        }

        .serenity-about-stamp {
            left: -30px;
        }

        .serenity-location-grid {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .serenity-map,
        .serenity-map iframe {
            min-height: 350px;
        }
    }

    @@media (max-width: 480px) {
        .serenity-home .section-padding {
            padding: 60px 0;
        }

        .serenity-hero {
            min-height: 550px;
        }

            .serenity-hero .hero-eyebrow {
                font-size: .65rem;
                letter-spacing: 2px;
            }

            .serenity-hero .hero-description {
                font-size: .95rem;
            }

            .serenity-hero .hero-actions {
                flex-direction: column;
                align-items: stretch;
                max-width: 260px;
            }

            .serenity-hero .serenity-btn {
                width: 100%;
            }

        .hero-bottom-note {
            margin-top: 35px;
        }

        .serenity-about-points {
            grid-template-columns: 1fr;
        }

        .serenity-about-image {
            height: 330px;
        }

        .serenity-about-stamp {
            width: 110px;
            height: 110px;
            bottom: 35px;
        }

        .serenity-map,
        .serenity-map iframe {
            min-height: 300px;
        }
    }

    /* CONTACT US */
    .serenity-home .serenity-contact {
        background: #faf6f0;
        padding: 90px 24px;
    }

    .serenity-home .serenity-contact-heading {
        max-width: 680px;
        margin: 0 auto 48px;
        text-align: center;
    }

        .serenity-home .serenity-contact-heading .section-description {
            margin-left: auto;
            margin-right: auto;
        }

    .serenity-home .serenity-contact-grid {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: 35px;
        max-width: 1100px;
        margin: 0 auto;
        align-items: stretch;
    }

    .serenity-home .serenity-contact-info,
    .serenity-home .serenity-contact-form-wrap {
        padding: 36px;
        border: 1px solid #eadfd2;
        border-radius: 18px;
    }

    .serenity-home .serenity-contact-info {
        background: #39251f;
        color: #fff8ef;
    }

        .serenity-home .serenity-contact-info h3,
        .serenity-home .serenity-contact-form-wrap h3 {
            margin: 0 0 12px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1.7rem;
        }

    .serenity-home .serenity-contact-intro {
        color: #e2d2c3;
        line-height: 1.8;
        margin-bottom: 30px;
    }

    .serenity-home .serenity-contact-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin: 25px 0;
    }

    .serenity-home .serenity-contact-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border: 1px solid #8d6b51;
        border-radius: 50%;
        color: #dfb98f;
    }

    .serenity-home .serenity-contact-item strong {
        display: block;
        margin: 2px 0 5px;
    }

    .serenity-home .serenity-contact-item p {
        margin: 0;
        color: #e2d2c3;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    .serenity-home .serenity-whatsapp-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        width: 100%;
        margin-top: 30px;
        padding: 14px 16px;
        border: 1px solid #dfb98f;
        border-radius: 8px;
        color: #fff8ef;
        text-decoration: none;
        font-weight: 600;
        transition: background .2s ease, color .2s ease;
    }

        .serenity-home .serenity-whatsapp-btn:hover {
            background: #dfb98f;
            color: #39251f;
        }

        .serenity-home .serenity-whatsapp-btn i {
            font-size: 1.25rem;
        }

    .serenity-home .serenity-contact-note {
        margin: 10px 0 0;
        color: #cbb8a7;
        font-size: .78rem;
        line-height: 1.6;
    }

    .serenity-home .serenity-contact-form-wrap {
        background: #fffdf9;
    }

        .serenity-home .serenity-contact-form-wrap > p {
            color: #84766c;
            line-height: 1.7;
            margin-bottom: 25px;
        }

    .serenity-home .serenity-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .serenity-home .serenity-form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }

        .serenity-home .serenity-form-group label {
            color: #39251f;
            font-size: .9rem;
            font-weight: 600;
        }

