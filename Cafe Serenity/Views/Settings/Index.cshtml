@{
    ViewData["Title"] = "Café Settings";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<style>
    :root {
        --setting-accent: #a87552;
        --setting-ink: #35251e;
        --setting-muted: #91847a;
        --setting-border: #eee5dc;
        --setting-bg: #f8f5f1;
    }

    .settings-page {
        color: var(--setting-ink);
        padding: 8px 0 35px;
    }

    .settings-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .settings-eyebrow {
        color: var(--setting-accent);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        margin-bottom: 9px;
    }

    .settings-heading h1 {
        font-size: clamp(27px, 3vw, 37px);
        font-weight: 800;
        letter-spacing: -1.2px;
        margin: 0 0 8px;
    }

    .settings-heading p {
        color: var(--setting-muted);
        margin: 0;
        font-size: 14px;
    }

    .settings-status {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #75856d;
        background: #edf2e9;
        padding: 10px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .settings-layout {
        display: grid;
        grid-template-columns: 235px minmax(0, 1fr);
        gap: 22px;
        align-items: start;
    }

    .settings-sidebar,
    .settings-panel,
    .settings-preview {
        background: white;
        border: 1px solid var(--setting-border);
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(65, 43, 29, .035);
    }

    .settings-sidebar {
        padding: 15px;
        position: sticky;
        top: 20px;
    }

    .settings-nav-label {
        color: #a3988e;
        font-size: 10px;
        letter-spacing: 1.8px;
        font-weight: 800;
        padding: 10px 11px 13px;
    }

    .settings-tab {
        display: flex;
        width: 100%;
        align-items: center;
        gap: 12px;
        padding: 13px 12px;
        border: 0;
        border-radius: 11px;
        background: transparent;
        text-align: left;
        color: #786b62;
        font-size: 13px;
        font-weight: 650;
        margin-bottom: 5px;
        transition: .2s ease;
    }

        .settings-tab i {
            font-size: 17px;
            width: 21px;
        }

        .settings-tab:hover {
            background: #faf5ef;
            color: var(--setting-ink);
            transform: translateX(2px);
        }

        .settings-tab.active {
            color: var(--setting-ink);
            background: #f5ece3;
            box-shadow: inset 3px 0 var(--setting-accent);
        }

    .settings-main {
        min-width: 0;
    }

    .settings-panel {
        padding: clamp(18px, 3vw, 30px);
        animation: panelEnter .25s ease;
    }

    @@keyframes panelEnter {
        from {
            opacity: 0;
            transform: translateY(7px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .panel-heading {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        align-items: flex-start;
        padding-bottom: 22px;
        border-bottom: 1px solid var(--setting-border);
        margin-bottom: 25px;
    }

        .panel-heading h2 {
            font-size: 21px;
            font-weight: 800;
            margin: 0 0 7px;
        }

        .panel-heading p {
            color: var(--setting-muted);
            font-size: 13px;
            margin: 0;
            line-height: 1.6;
        }

    .panel-icon {
        width: 47px;
        height: 47px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        background: #f5ece3;
        color: var(--setting-accent);
        border-radius: 14px;
        font-size: 21px;
    }

    .settings-section-title {
        font-size: 13px;
        font-weight: 800;
        margin: 24px 0 15px;
    }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 19px;
    }

    .settings-field {
        min-width: 0;
    }

        .settings-field.full {
            grid-column: 1 / -1;
        }

        .settings-field label {
            display: block;
            color: #5e5047;
            font-size: 12px;
            font-weight: 750;
            margin-bottom: 8px;
        }

        .settings-field input,
        .settings-field select,
        .settings-field textarea {
            width: 100%;
            min-width: 0;
            background: #fdfcfb;
            border: 1px solid #e9dfd6;
            border-radius: 9px;
            padding: 12px 13px;
            color: var(--setting-ink);
            outline: none;
            font-size: 13px;
            transition: .2s;
        }

            .settings-field input:focus,
            .settings-field select:focus,
            .settings-field textarea:focus {
                border-color: var(--setting-accent);
                box-shadow: 0 0 0 3px rgba(168, 117, 82, .12);
            }

    .field-hint {
        color: #a09489;
        font-size: 11px;
        margin-top: 7px;
    }

    .preview-card {
        margin-top: 23px;
        padding: 20px;
        border-radius: 13px;
        background: var(--setting-ink);
        color: #fff7ef;
        position: relative;
        overflow: hidden;
    }

        .preview-card::after {
            content: "";
            position: absolute;
            width: 140px;
            height: 140px;
            border: 1px solid rgba(255,255,255,.09);
            border-radius: 50%;
            right: -40px;
            top: -65px;
        }

    .preview-label {
        color: #cbb39e;
        font-size: 9px;
        letter-spacing: 2px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .preview-name {
        font-family: Georgia, serif;
        font-size: 24px;
        margin-bottom: 5px;
    }

    .preview-detail {
        color: #d0c1b6;
        font-size: 12px;
    }

    .preview-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--setting-accent);
        margin-right: 6px;
    }

    .setting-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 17px 0;
        border-bottom: 1px solid #f0e9e3;
    }

        .setting-row:last-child {
            border-bottom: 0;
        }

        .setting-row h4 {
            font-size: 13px;
            font-weight: 750;
            margin: 0 0 5px;
        }

        .setting-row p {
            color: var(--setting-muted);
            font-size: 12px;
            margin: 0;
            line-height: 1.5;
        }

    .setting-switch {
        width: 43px;
        height: 24px;
        position: relative;
        flex-shrink: 0;
    }

        .setting-switch input {
            width: 0;
            height: 0;
            opacity: 0;
        }

    .switch-track {
        position: absolute;
        inset: 0;
        border-radius: 20px;
        background: #d9d0c8;
        cursor: pointer;
        transition: .2s;
    }

        .switch-track::before {
            content: "";
            position: absolute;
            width: 18px;
            height: 18px;
            left: 3px;
            top: 3px;
            border-radius: 50%;
            background: white;
            transition: .2s;
            box-shadow: 0 1px 4px #0002;
        }

    .setting-switch input:checked + .switch-track {
        background: var(--setting-accent);
    }

        .setting-switch input:checked + .switch-track::before {
            transform: translateX(19px);
        }

    .setting-switch input:focus-visible + .switch-track {
        outline: 3px solid #d7b69c;
        outline-offset: 3px;
    }

    .hours-row {
        display: grid;
        grid-template-columns: minmax(90px, 1fr) 100px 100px 43px;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #f2ebe5;
    }

    .hours-day {
        font-size: 13px;
        font-weight: 700;
    }

    .hours-row input[type="time"] {
        width: 100%;
        padding: 9px 5px;
        font-size: 12px;
        border: 1px solid #e9dfd6;
        border-radius: 7px;
        background: #fdfcfb;
    }

    .hours-row.closed .hours-time {
        opacity: .35;
        pointer-events: none;
    }

    .colour-options {
        display: flex;
        gap: 13px;
        flex-wrap: wrap;
    }

    .colour-choice {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 3px solid white;
        outline: 1px solid #e4d9cf;
        cursor: pointer;
        transition: .2s;
    }

        .colour-choice.active {
            outline: 2px solid var(--setting-ink);
            transform: scale(1.08);
        }

    .settings-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

        .settings-footer small {
            color: var(--setting-muted);
            font-size: 11px;
        }

    .settings-actions {
        display: flex;
        gap: 9px;
    }

    .settings-btn {
        border-radius: 9px;
        padding: 11px 16px;
        font-size: 12px;
        font-weight: 750;
        border: 1px solid #e7ddd4;
        background: white;
        color: var(--setting-ink);
        transition: .2s;
    }

        .settings-btn:hover {
            transform: translateY(-1px);
        }

        .settings-btn.primary {
            background: var(--setting-accent);
            color: white;
            border-color: var(--setting-accent);
        }

    .settings-search {
        position: relative;
        margin-bottom: 18px;
    }

        .settings-search input {
            width: 100%;
            border: 1px solid var(--setting-border);
            border-radius: 10px;
            background: white;
            padding: 12px 14px 12px 40px;
            font-size: 12px;
            outline: none;
        }

        .settings-search i {
            position: absolute;
            left: 14px;
            top: 13px;
            color: #a09489;
        }

    .settings-empty {
        display: none;
        padding: 30px 10px;
        color: var(--setting-muted);
        font-size: 13px;
        text-align: center;
    }

    @@media (max-width: 850px) {
        .settings-layout {
            grid-template-columns: 1fr;
        }

        .settings-sidebar {
            position: static;
            display: flex;
            overflow-x: auto;
            gap: 5px;
            padding: 10px;
        }

        .settings-nav-label {
            display: none;
        }

        .settings-tab {
            width: auto;
            min-width: max-content;
            margin: 0;
        }
    }

    @@media (max-width: 540px) {
        .settings-grid {
            grid-template-columns: 1fr;
        }

        .settings-field.full {
            grid-column: auto;
        }

        .hours-row {
            grid-template-columns: minmax(75px, 1fr) 80px 80px 38px;
            gap: 6px;
        }

            .hours-row input[type="time"] {
                font-size: 10px;
            }

        .settings-footer,
        .settings-actions {
            width: 100%;
        }

            .settings-actions button {
                flex: 1;
            }
    }
</style>

<div class="settings-page" id="cafeSettings">

    <div class="settings-heading">
        <div>
            <div class="settings-eyebrow">Café Serenity / Control centre</div>
            <h1>Settings<span style="color:var(--setting-accent)">.</span></h1>
            <p>Make your café feel exactly the way you want it to.</p>
        </div>

        <div class="settings-status" id="saveStatus" role="status">
            <i class="bi bi-check-circle-fill"></i>
            <span>All changes saved</span>
        </div>
    </div>

    <div class="settings-layout">

        <aside class="settings-sidebar">
            <div class="settings-nav-label">PREFERENCES</div>

            <button class="settings-tab active" data-tab="general">
                <i class="bi bi-shop"></i> General
            </button>

            <button class="settings-tab" data-tab="hours">
                <i class="bi bi-clock"></i> Business hours
            </button>

            <button class="settings-tab" data-tab="appearance">
                <i class="bi bi-palette"></i> Appearance
            </button>

            <button class="settings-tab" data-tab="notifications">
                <i class="bi bi-bell"></i> Notifications
            </button>

            <button class="settings-tab" data-tab="preferences">
                <i class="bi bi-sliders"></i> Preferences
            </button>
        </aside>

        <main class="settings-main">

            <div class="settings-search">
                <i class="bi bi-search"></i>
                <input type="search" id="settingsSearch"
                       placeholder="Search settings, e.g. opening hours..."
                       aria-label="Search settings" />
            </div>

            <!-- GENERAL -->
            <section class="settings-panel settings-section" id="tab-general"
                     data-search="general cafe shop business name contact email phone address">

                <div class="panel-heading">
                    <div>
                        <h2>General information</h2>
                        <p>Manage the details customers see about your café.</p>
                    </div>
                    <div class="panel-icon"><i class="bi bi-shop"></i></div>
                </div>

                <div class="settings-section-title">Business identity</div>

                <div class="settings-grid">
                    <div class="settings-field">
                        <label for="cafeName">Café name</label>
                        <input id="cafeName" data-setting
                               value="Café Serenity" maxlength="80" />
                    </div>

                    <div class="settings-field">
                        <label for="tagline">Tagline</label>
                        <input id="tagline" data-setting
                               value="Coffee, comfort & connection"
                               maxlength="120" />
                    </div>

                    <div class="settings-field">
                        <label for="contactEmail">Business email</label>
                        <input id="contactEmail" data-setting
                               type="email" placeholder="hello@cafeserenity.co.za" />
                    </div>

                    <div class="settings-field">
                        <label for="contactPhone">Phone number</label>
                        <input id="contactPhone" data-setting
                               type="tel" placeholder="+27 ..." />
                    </div>

                    <div class="settings-field full">
                        <label for="cafeAddress">Physical address</label>
                        <input id="cafeAddress" data-setting
                               placeholder="Enter your café's address" />
                        <div class="field-hint">
                            This can be displayed on your customer-facing website.
                        </div>
                    </div>
                </div>

                <div class="preview-card">
                    <div class="preview-label">LIVE BUSINESS PREVIEW</div>
                    <div class="preview-name" id="previewName">Café Serenity</div>
                    <div class="preview-detail" id="previewTagline">
                        Coffee, comfort & connection
                    </div>
                    <div class="preview-detail" style="margin-top:13px">
                        <span class="preview-dot"></span>
                        Your café identity at a glance
                    </div>
                </div>
            </section>

            <!-- BUSINESS HOURS -->
            <section class="settings-panel settings-section" id="tab-hours"
                     data-search="hours opening closing open closed weekdays weekend schedule">

                <div class="panel-heading">
                    <div>
                        <h2>Business hours</h2>
                        <p>Set the hours your café is open to customers.</p>
                    </div>
                    <div class="panel-icon"><i class="bi bi-clock"></i></div>
                </div>

                <div style="display:flex;justify-content:space-between;gap:10px;
                            margin-bottom:12px;color:#9a8c81;font-size:10px;
                            font-weight:800;text-transform:uppercase;">
                    <span>Day</span>
                    <span style="margin-left:auto">Opening / closing</span>
                    <span style="width:43px;text-align:center">Open</span>
                </div>

                <div id="businessHours">
                    @{
                        var days = new[] {
                                        new { Name = "Monday", Open = "08:00", Close = "17:00", Enabled = true },
                                        new { Name = "Tuesday", Open = "08:00", Close = "17:00", Enabled = true },
                                        new { Name = "Wednesday", Open = "08:00", Close = "17:00", Enabled = true },
                                        new { Name = "Thursday", Open = "08:00", Close = "17:00", Enabled = true },
                                        new { Name = "Friday", Open = "08:00", Close = "18:00", Enabled = true },
                                        new { Name = "Saturday", Open = "09:00", Close = "16:00", Enabled = true },
                                        new { Name = "Sunday", Open = "09:00", Close = "14:00", Enabled = false }
                                        };
                    }

                    @foreach (var day in days)
                    {
                        <div class="hours-row @(day.Enabled ? "" : "closed")"
                             data-day="@day.Name">
                            <span class="hours-day">@day.Name</span>

                            <input class="hours-time" type="time"
                                   aria-label="@day.Name opening time"
                                   value="@day.Open" data-setting />

                            <input class="hours-time" type="time"
                                   aria-label="@day.Name closing time"
                                   value="@day.Close" data-setting />

                            <label class="setting-switch">
                                <input type="checkbox" data-setting
                                       aria-label="@day.Name open"
                                       checked="@day.Enabled" />
                                <span class="switch-track"></span>
                            </label>
                        </div>
                    }
                </div>

                <div class="field-hint" style="margin-top:15px">
                    These hours are a starting point. Adjust them to match your actual business schedule.
                </div>
            </section>

            <!-- APPEARANCE -->
            <section class="settings-panel settings-section" id="tab-appearance"
                     data-search="appearance theme colour color accent branding design">

                <div class="panel-heading">
                    <div>
                        <h2>Appearance</h2>
                        <p>Personalise the look and feel of your owner dashboard.</p>
                    </div>
                    <div class="panel-icon"><i class="bi bi-palette"></i></div>
                </div>

                <div class="settings-section-title">Dashboard accent colour</div>
                <p style="color:var(--setting-muted);font-size:12px;margin-bottom:17px">
                    Select a colour to update the accents on this page instantly.
                </p>

                <div class="colour-options">
                    <button type="button" class="colour-choice active"
                            data-colour="#a87552" style="background:#a87552"
                            aria-label="Caramel accent"></button>

                    <button type="button" class="colour-choice"
                            data-colour="#6c4937" style="background:#6c4937"
                            aria-label="Espresso accent"></button>

                    <button type="button" class="colour-choice"
                            data-colour="#74816a" style="background:#74816a"
                            aria-label="Sage accent"></button>

                    <button type="button" class="colour-choice"
                            data-colour="#9b6870" style="background:#9b6870"
                            aria-label="Rose accent"></button>

                    <button type="button" class="colour-choice"
                            data-colour="#647d91" style="background:#647d91"
                            aria-label="Slate blue accent"></button>
                </div>

                <div class="preview-card" style="margin-top:27px">
                    <div class="preview-label">YOUR SELECTED STYLE</div>
                    <div class="preview-name">A little moment of calm.</div>
                    <div class="preview-detail">
                        <span class="preview-dot"></span>
                        Your café, your identity.
                    </div>
                </div>

                <div class="setting-row">
                    <div>
                        <h4>Compact dashboard cards</h4>
                        <p>Use a tighter layout to fit more information on screen.</p>
                    </div>
                    <label class="setting-switch">
                        <input type="checkbox" data-setting
                               id="compactCards" aria-label="Compact dashboard cards" />
                        <span class="switch-track"></span>
                    </label>
                </div>
            </section>

            <!-- NOTIFICATIONS -->
            <section class="settings-panel settings-section" id="tab-notifications"
                     data-search="notifications alerts email stock orders summary low stock">

                <div class="panel-heading">
                    <div>
                        <h2>Notifications</h2>
                        <p>Choose which updates you want your café dashboard to highlight.</p>
                    </div>
                    <div class="panel-icon"><i class="bi bi-bell"></i></div>
                </div>

                <div class="setting-row">
                    <div>
                        <h4>Low-stock alerts</h4>
                        <p>Flag products when inventory is running low.</p>
                    </div>
                    <label class="setting-switch">
                        <input type="checkbox" data-setting checked
                               aria-label="Low-stock alerts" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div>
                        <h4>Order notifications</h4>
                        <p>Highlight new orders and order status changes.</p>
                    </div>
                    <label class="setting-switch">
                        <input type="checkbox" data-setting checked
                               aria-label="Order notifications" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div>
                        <h4>Daily business summary</h4>
                        <p>Enable a daily summary preference for sales and activity.</p>
                    </div>
                    <label class="setting-switch">
                        <input type="checkbox" data-setting
                               aria-label="Daily business summary" />
                        <span class="switch-track"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div>
                        <h4>Email notifications</h4>
                        <p>Preference for receiving café updates by email.</p>
                    </div>
                    <label class="setting-switch">
                        <input type="checkbox" data-setting
                               aria-label="Email notifications" />
                        <span class="switch-track"></span>
                    </label>
                </div>
            </section>

            <!-- PREFERENCES -->
            <section class="settings-panel settings-section" id="tab-preferences"
                     data-search="preferences currency timezone language menu tax">

                <div class="panel-heading">
                    <div>
                        <h2>System preferences</h2>
                        <p>Set the defaults used throughout your café dashboard.</p>
                    </div>
                    <div class="panel-icon"><i class="bi bi-sliders"></i></div>
                </div>

                <div class="settings-grid">
                    <div class="settings-field">
                        <label for="currency">Display currency</label>
                        <select id="currency" data-setting>
                            <option value="ZAR" selected>ZAR — South African Rand (R)</option>
                            <option value="USD">USD — US Dollar ($)</option>
                            <option value="GBP">GBP — British Pound (£)</option>
                            <option value="EUR">EUR — Euro (€)</option>
                        </select>
                    </div>

                    <div class="settings-field">
                        <label for="timezone">Time zone</label>
                        <select id="timezone" data-setting>
                            <option value="Africa/Johannesburg" selected>
                                South Africa (SAST)
                            </option>
                            <option value="UTC">UTC</option>
                            <option value="Europe/London">London</option>
                        </select>
                    </div>

                    <div class="settings-field">
                        <label for="menuLayout">Customer menu layout</label>
                        <select id="menuLayout" data-setting>
                            <option value="grid" selected>Product grid</option>
                            <option value="list">Compact list</option>
                        </select>
                    </div>

                    <div class="settings-field">
                        <label for="itemsPerPage">Products per page</label>
                        <select id="itemsPerPage" data-setting>
                            <option value="8">8 products</option>
                            <option value="12" selected>12 products</option>
                            <option value="16">16 products</option>
                            <option value="24">24 products</option>
                        </select>
                    </div>
                </div>

                <div class="setting-row" style="margin-top:17px">
                    <div>
                        <h4>Show unavailable products</h4>
                        <p>Keep out-of-stock items visible on the customer menu.</p>
                    </div>
                    <label class="setting-switch">
                        <input type="checkbox" data-setting
                               aria-label="Show unavailable products" />
                        <span class="switch-track"></span>
                    </label>
                </div>
            </section>

            <div class="settings-empty" id="noSearchResults">
                <i class="bi bi-search" style="font-size:22px"></i>
                <p>No settings matched your search.</p>
            </div>

            <div class="settings-footer">
                <small id="changeMessage">Your preferences are ready to customise.</small>

                <div class="settings-actions">
                    <button class="settings-btn" type="button" id="resetSettings">
                        Reset changes
                    </button>

                    <button class="settings-btn primary" type="button" id="saveSettings">
                        <i class="bi bi-check2-circle"></i>
                        Save changes
                    </button>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const root = document.getElementById("cafeSettings");
        const tabs = [...root.querySelectorAll(".settings-tab")];
        const panels = [...root.querySelectorAll(".settings-section")];
        const search = document.getElementById("settingsSearch");
        const status = document.getElementById("saveStatus");
        const message = document.getElementById("changeMessage");
        const saveButton = document.getElementById("saveSettings");
        const resetButton = document.getElementById("resetSettings");

        let savedValues = new Map();
        let activeColour = "#a87552";
        let savedColour = activeColour;

        function getControls() {
            return [...root.querySelectorAll("[data-setting]")];
        }

        function readValue(control) {
            return control.type === "checkbox" ? control.checked : control.value;
        }

        function snapshot() {
            return new Map(getControls().map((control, index) => [
                index,
                readValue(control)
            ]));
        }

        function applySnapshot(values) {
            getControls().forEach((control, index) => {
                if (!values.has(index)) return;

                if (control.type === "checkbox") {
                    control.checked = values.get(index);
                    control.dispatchEvent(new Event("change"));
                } else {
                    control.value = values.get(index);
                    control.dispatchEvent(new Event("input"));
                }
            });
        }

        function hasChanges() {
            const current = snapshot();

            if (current.size !== savedValues.size || activeColour !== savedColour) {
                return true;
            }

            for (const [key, value] of current) {
                if (savedValues.get(key) !== value) return true;
            }

            return false;
        }

        function updateStatus() {
            const changed = hasChanges();

            status.innerHTML = changed
                ? '<i class="bi bi-exclamation-circle-fill"></i><span>Unsaved changes</span>'
                : '<i class="bi bi-check-circle-fill"></i><span>All changes saved</span>';

            status.style.background = changed ? "#fff0d9" : "#edf2e9";
            status.style.color = changed ? "#91651c" : "#75856d";

            message.textContent = changed
                ? "You have changes that have not been saved."
                : "Your preferences are ready to customise.";
        }

        function activateTab(tabName) {
            tabs.forEach(tab => {
                tab.classList.toggle("active", tab.dataset.tab === tabName);
            });

            panels.forEach(panel => {
                panel.style.display = panel.id === "tab-" + tabName ? "block" : "none";
            });
        }

        tabs.forEach(tab => {
            tab.addEventListener("click", () => {
                search.value = "";
                panels.forEach(panel => panel.style.display = "none");
                activateTab(tab.dataset.tab);
            });
        });

        function updatePreview() {
            const name = document.getElementById("cafeName").value.trim();
            const tagline = document.getElementById("tagline").value.trim();

            document.getElementById("previewName").textContent = name || "Your café name";
            document.getElementById("previewTagline").textContent =
                tagline || "Your café tagline";
        }

        document.getElementById("cafeName").addEventListener("input", updatePreview);
        document.getElementById("tagline").addEventListener("input", updatePreview);

        root.querySelectorAll(".colour-choice").forEach(button => {
            button.addEventListener("click", () => {
                activeColour = button.dataset.colour;
                document.documentElement.style.setProperty("--setting-accent", activeColour);

                root.querySelectorAll(".colour-choice").forEach(choice => {
                    choice.classList.toggle("active", choice === button);
                });

                updateStatus();
            });
        });

        root.querySelectorAll(".hours-row input[type='checkbox']").forEach(toggle => {
            toggle.addEventListener("change", () => {
                toggle.closest(".hours-row").classList.toggle("closed", !toggle.checked);
            });
        });

        document.getElementById("compactCards").addEventListener("change", event => {
            const compact = event.target.checked;
            root.querySelectorAll(".settings-panel").forEach(panel => {
                panel.style.padding = compact ? "18px" : "";
            });
        });

        search.addEventListener("input", () => {
            const query = search.value.trim().toLowerCase();
            let matches = 0;

            panels.forEach(panel => {
                const haystack = (
                    panel.dataset.search + " " + panel.innerText
                ).toLowerCase();

                const matched = !query || haystack.includes(query);
                panel.style.display = matched ? "block" : "none";

                if (matched) matches++;
            });

            tabs.forEach(tab => {
                const panel = document.getElementById("tab-" + tab.dataset.tab);
                const haystack = (
                    panel.dataset.search + " " + panel.innerText
                ).toLowerCase();

                tab.style.display = !query || haystack.includes(query)
                    ? "flex" : "none";
            });

            document.getElementById("noSearchResults").style.display =
                matches === 0 ? "block" : "none";
        });

        getControls().forEach(control => {
            control.addEventListener("input", updateStatus);
            control.addEventListener("change", updateStatus);
        });

        saveButton.addEventListener("click", () => {
            // Demo save only. Server/database persistence is the next step.
            savedValues = snapshot();
            savedColour = activeColour;
            updateStatus();

            message.textContent =
                "Changes accepted in this demo. Database saving is not connected yet.";

            saveButton.innerHTML = '<i class="bi bi-check2"></i> Changes accepted';
            setTimeout(() => {
                saveButton.innerHTML =
                    '<i class="bi bi-check2-circle"></i> Save changes';
            }, 1800);
        });

        resetButton.addEventListener("click", () => {
            if (!confirm("Discard your unsaved changes?")) return;

            applySnapshot(savedValues);
            activeColour = savedColour;
            document.documentElement.style.setProperty("--setting-accent", activeColour);

            root.querySelectorAll(".colour-choice").forEach(button => {
                button.classList.toggle("active", button.dataset.colour === activeColour);
            });

            updatePreview();
            updateStatus();
        });

        savedValues = snapshot();
        savedColour = activeColour;
        activateTab("general");
        updatePreview();
        updateStatus();
    });
</script>